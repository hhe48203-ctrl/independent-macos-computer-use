{
  "name": "independent-macos-computer-use",
  "version": "1.3.0",
  "description": "Independent macOS desktop perception and control over MCP stdio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "macos-computer-use-mcp": "src/server.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint \"src/**/*.{js,mjs}\"",
    "check": "npm run lint && node scripts/check.mjs",
    "check:native": "CU_BUILD_DIRECTORY=.build npm run build && node scripts/check.mjs --native",
    "test:desktop": "node scripts/repl-desktop-test.mjs",
    "test:pi": "node scripts/pi-test.mjs",
    "package": "node scripts/package.mjs",
    "test:background": "node scripts/repl-desktop-test.mjs",
    "test:background:interactive": "node scripts/ime-concurrency-test.mjs",
    "package:evidence": "node scripts/package-evidence.mjs",
    "test:packaged-background": "node scripts/packaged-repl-test.mjs",
    "test:cursor": "node scripts/repl-cursor-lifecycle-test.mjs",
    "test:pi:document": "node scripts/pi-repl-document-test.mjs",
    "test:document": "node scripts/repl-document-test.mjs",
    "test:input-options": "node scripts/repl-input-options-test.mjs",
    "test:reconnect": "node scripts/repl-reconnect-test.mjs",
    "test:scroll": "node scripts/scroll-calibration-test.mjs --independent",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:bilingual": "node scripts/build-bilingual.mjs",
    "test:focus": "node scripts/focus-cause-test.mjs --without-appkit --regular",
    "test:document:cooperative": "CU_TEST_SCOPED_FOCUS=0 node scripts/repl-document-test.mjs",
    "test:cursor:occlusion": "node scripts/repl-cursor-occlusion-test.mjs",
    "test:packaged-cursor": "node scripts/packaged-cursor-test.mjs",
    "bench:v2": "node scripts/bench-v2.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.4.3"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "yaml": "2.9.1"
  }
}
